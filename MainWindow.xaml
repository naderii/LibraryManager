<Window x:Class="LibraryManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت کتابخانه"
        Height="820" Width="1280" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- سایدبار -->
    <Border Grid.Column="0" Background="#183B56">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="16,22,16,8">
          <Border Width="48" Height="48" CornerRadius="12" Background="#176B87" HorizontalAlignment="Right">
            <TextBlock Text="کتاب" FontSize="15" FontWeight="Bold" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="کتابخانه من" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,12,0,2"/>
          <TextBlock Text="سامانه مدیریت" FontSize="11" Foreground="#91AFC1"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="عملیات روزانه" Foreground="#91AFC1" Margin="16,8,16,6" FontSize="11"/>
            <Button Content="فهرست کتاب‌ها" Tag="Books" Click="Navigate" Style="{StaticResource NavButton}"/>
            <Button Content="اعضا" Tag="Members" Click="Navigate" Style="{StaticResource NavButton}"/>
            <Button Content="ثبت امانت" Tag="Loans" Click="Navigate" Style="{StaticResource NavButton}"/>
            <Button Content="بازگرداندن کتاب" Tag="Returns" Click="Navigate" Style="{StaticResource NavButton}"/>
            <Button Content="جریمه‌ها" Tag="Fines" Click="Navigate" Style="{StaticResource NavButton}"/>

            <Separator Margin="16,12" Background="#36566D"/>
            <TextBlock Text="سایر" Foreground="#91AFC1" Margin="16,4,16,6" FontSize="11"/>
            <Button Content="گزارش‌ها" Tag="Reports" Click="Navigate" Style="{StaticResource NavButton}"/>
            <Button Content="پشتیبان‌گیری" Tag="Backup" Click="Navigate" Style="{StaticResource NavButton}"/>
            <Button Content="تنظیمات" Tag="Settings" Click="Navigate" Style="{StaticResource NavButton}"/>
          </StackPanel>
        </ScrollViewer>

        <Border DockPanel.Dock="Bottom" Background="#122B3E" Padding="14,12" Margin="0,8,0,0">
          <TextBlock Text="میانبر منو: Ctrl + ۱ تا ۸" Foreground="#7BA3B8" FontSize="11" TextWrapping="Wrap"/>
        </Border>
      </DockPanel>
    </Border>

    <!-- محتوا -->
    <Grid Grid.Column="1" Background="#F3F6FA">
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
        <TextBlock x:Name="PageTitle" Text="پنل مدیریت" FontSize="16" FontWeight="Bold"
                   Foreground="#183B56" VerticalAlignment="Center" Margin="24,0"/>
      </Border>
      <ContentControl x:Name="Host" Grid.Row="1" Margin="16"/>
    </Grid>
  </Grid>
</Window>
