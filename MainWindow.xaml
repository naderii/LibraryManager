<Window x:Class="LibraryManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Library Manager | مدیریت کتابخانه" Height="820" Width="1320" MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#183B56">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="18,24,18,22">
          <Border Width="52" Height="52" CornerRadius="15" Background="#176B87" HorizontalAlignment="Right"><TextBlock Text="کتاب" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
          <TextBlock Text="کتابخانه من" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,14,0,4"/>
          <TextBlock Text="سامانه مدیریت کتابخانه" FontSize="11" Foreground="#B8CAD8"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="منوی اصلی" Foreground="#91AFC1" Margin="18,4,18,8" FontSize="11"/>
          <Button Content="فهرست کتاب‌ها" Tag="Books" Click="Navigate" Style="{StaticResource NavButton}"/>
          <Button Content="اعضا" Tag="Members" Click="Navigate" Style="{StaticResource NavButton}"/>
          <Button Content="ثبت امانت" Tag="Loans" Click="Navigate" Style="{StaticResource NavButton}"/>
          <Button Content="بازگرداندن کتاب" Tag="Returns" Click="Navigate" Style="{StaticResource NavButton}"/>
          <Button Content="جریمه‌های پرداخت‌نشده" Tag="Fines" Click="Navigate" Style="{StaticResource NavButton}"/>
          <Button Content="گزارش‌ها" Tag="Reports" Click="Navigate" Style="{StaticResource NavButton}"/>
          <Separator Margin="18,14" Background="#36566D"/>
          <Button Content="پشتیبان‌گیری" Tag="Backup" Click="Navigate" Style="{StaticResource NavButton}"/>
          <Button Content="تنظیمات" Tag="Settings" Click="Navigate" Style="{StaticResource NavButton}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Library Manager • نسخه دسکتاپ" Foreground="#91AFC1" FontSize="10" Margin="18,18"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
        <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="پنل مدیریت کتابخانه" FontSize="17" FontWeight="Bold" Foreground="#183B56" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="مدیریت کتاب‌ها، اعضا و امانت‌ها" Foreground="#64748B" VerticalAlignment="Center"/></Grid>
      </Border>
      <ContentControl x:Name="Host" Grid.Row="1" Margin="12"/>
    </Grid>
  </Grid>
</Window>
