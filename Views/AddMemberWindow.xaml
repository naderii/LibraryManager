<Window x:Class="LibraryManager.Views.AddMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ثبت عضو جدید" Width="520" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft" FontFamily="Tahoma">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="ثبت عضو جدید" FontSize="20" FontWeight="Bold" Foreground="#183B56"/>
      <TextBlock Text="با Enter بین فیلدها جابه‌جا شوید. Ctrl+S برای ثبت." Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid x:Name="FormGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
      </Grid>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
      <Button x:Name="SaveBtn" Content="ثبت عضو و دریافت حق عضویت" IsDefault="True" Click="Save_Click" MinWidth="200" Margin="0,0,8,0"/>
      <Button Content="انصراف" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="90" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
