<Window x:Class="LibraryManager.Views.ReturnConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأیید بازگشت" Width="400" Height="220" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ResizeMode="NoResize">
  <StackPanel Margin="20">
    <TextBlock x:Name="Msg" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <StackPanel Orientation="Horizontal">
      <Button Content="تأیید" IsDefault="True" Click="Ok" MinWidth="100" Margin="0,0,8,0"/>
      <Button Content="انصراف" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="90"/>
    </StackPanel>
  </StackPanel>
</Window>
